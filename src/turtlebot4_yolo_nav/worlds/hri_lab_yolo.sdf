<?xml version="1.0"?>
<sdf version="1.8">
  <world name="hri_lab">
    <physics name="1ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.15 0.18 0.22 1</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 0.1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>12 10 0.1</size></box></geometry>
          <material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!-- Four perimeter walls form a bounded mapping area. -->
    <model name="wall_north"><static>true</static><pose>0 5 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_south"><static>true</static><pose>0 -5 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.2 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 0.2 1</size></box></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_east"><static>true</static><pose>6 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 10 1</size></box></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
    </link></model>
    <model name="wall_west"><static>true</static><pose>-6 0 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.2 10 1</size></box></geometry><material><ambient>0.8 0.8 0.82 1</ambient><diffuse>0.8 0.8 0.82 1</diffuse></material></visual>
    </link></model>

    <!-- Interior structures create corridors and distinct LiDAR geometry. -->
    <model name="partition_a"><static>true</static><pose>-1.3 1.3 0.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.25 4.7 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.25 4.7 1</size></box></geometry><material><ambient>0.25 0.5 0.8 1</ambient><diffuse>0.25 0.5 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="partition_b"><static>true</static><pose>2.0 -1.5 0.5 0 0 1.5708</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.25 4.5 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.25 4.5 1</size></box></geometry><material><ambient>0.25 0.5 0.8 1</ambient><diffuse>0.25 0.5 0.8 1</diffuse></material></visual>
    </link></model>
    <model name="pillar"><static>true</static><pose>3.8 2.8 0.6 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.45</radius><length>1.2</length></cylinder></geometry><material><ambient>0.8 0.45 0.15 1</ambient><diffuse>0.8 0.45 0.15 1</diffuse></material></visual>
    </link></model>

    <!-- Lightweight local objects provide camera targets without Gazebo Fuel. -->
    <include>
      <uri>model://realistic_chair</uri>
      <name>chair</name>
      <pose>-2.3 0.5 0 0 0 3.14159265359</pose>
    </include>

    <model name="stop_sign"><static>true</static><pose>1.7 -2.5 0 0 0 0</pose><link name="link">
      <collision name="pole_collision"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>1.1</length></cylinder></geometry></collision>
      <visual name="pole"><pose>0 0 0.55 0 0 0</pose><geometry><cylinder><radius>0.035</radius><length>1.1</length></cylinder></geometry><material><ambient>0.65 0.65 0.65 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material></visual>
      <collision name="sign_collision"><pose>0 0 1.15 0 1.5708 0</pose><geometry><cylinder><radius>0.32</radius><length>0.06</length></cylinder></geometry></collision>
      <visual name="sign"><pose>0 0 1.15 0 1.5708 0</pose><geometry><cylinder><radius>0.32</radius><length>0.06</length></cylinder></geometry><material><ambient>0.9 0.02 0.02 1</ambient><diffuse>0.9 0.02 0.02 1</diffuse></material></visual>
    </link></model>

    <include>
      <uri>model://realistic_plant</uri>
      <name>potted_plant</name>
      <pose>5.2 -0.5 0 0 0 0</pose>
    </include>

  </world>
</sdf>
